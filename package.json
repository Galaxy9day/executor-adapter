{
  "name": "@galaxy9day/pi-adapter",
  "version": "0.1.7",
  "description": "Pi (GPT-5.5) executor MCP for Trellis-aware and standalone use. Reads Trellis task artifacts, runs Pi in an isolated subprocess/worktree, and can optionally emit non-invasive Trellis channel audit messages.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "pi-adapter": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/*.test.js",
    "smoke": "printf '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"pi-adapter-smoke\",\"version\":\"0.0.0\"}}}\\n{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}\\n' | node index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@iarna/toml": "^2.2.5",
    "@mindfoldhq/trellis-core": "^0.6.0-beta.13"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "pi",
    "pi-coder",
    "trellis",
    "channel-audit",
    "ai-agent",
    "executor",
    "anthropic"
  ],
  "author": "galaxy9day (https://github.com/Galaxy9day)",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Galaxy9day/pi-adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Galaxy9day/pi-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/Galaxy9day/pi-adapter/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
